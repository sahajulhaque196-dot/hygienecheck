# ==========================================
# HygieneCheck.uk — Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER put real credentials in this file
# ==========================================

# GitHub Personal Access Token
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/hygienecheck.git

# CockroachDB — Main Database (PostgreSQL compatible)
# Get from: https://cockroachlabs.cloud
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-CLUSTER.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Supabase (unused — using CockroachDB)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
